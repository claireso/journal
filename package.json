{
  "name": "journal",
  "version": "5.1.7",
  "description": "A self-hosted website to show your photographs",
  "private": true,
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:sw\" \"node server.js\"",
    "build": "npm run build:sw && next build",
    "build:sw": "NODE_ENV=production node scripts/build/serviceworker.mjs",
    "dev:sw": "WATCH=true node scripts/build/serviceworker.mjs",
    "start": "node .next/standalone/server.js",
    "preview": "next start",
    "start:express": "NODE_ENV=production COMPRESSION=enabled node server.js",
    "lint": "oxlint . && oxfmt --check",
    "lint:write": "oxlint . --fix && oxfmt",
    "test": "npm run test:web && npm run test:node",
    "test:web": "jest --coverage --passWithNoTests --verbose --config jest.config.js",
    "test:node": "jest --coverage --passWithNoTests --verbose --config jest.node.config.js",
    "sb": "storybook dev -p 6006",
    "db:reset": "babel-node scripts/db/reset.js",
    "db:seed": "babel-node scripts/db/seed.js",
    "prepare": "husky",
    "build-storybook": "storybook build",
    "e2e": "cypress open"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/claireso/journal.git"
  },
  "author": "Claire Sosset",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/claireso/journal/issues"
  },
  "homepage": "https://github.com/claireso/journal#readme",
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@logtail/node": "0.5.8",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/instrumentation-pg": "0.76.0",
    "@vanilla-extract/css": "1.21.1",
    "@vanilla-extract/recipes": "0.5.7",
    "@vercel/otel": "2.1.3",
    "better-auth": "1.6.23",
    "colorthief": "3.4.0",
    "date-fns": "4.4.0",
    "lodash": "4.18.1",
    "next": "16.4.2",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "ulid": "3.0.2",
    "web-push": "3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/node": "7.29.7",
    "@changesets/cli": "3.0.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-links": "10.6.3",
    "@storybook/addon-webpack5-compiler-swc": "4.0.3",
    "@storybook/react-webpack5": "10.6.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.24",
    "@types/node": "24.12.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vanilla-extract/jest-transform": "1.1.22",
    "@vanilla-extract/next-plugin": "2.5.2",
    "@vanilla-extract/webpack-plugin": "2.3.27",
    "@vitest/mocker": "4.1.12",
    "babel-loader": "10.1.1",
    "babel-plugin-module-resolver": "5.0.3",
    "babel-plugin-react-remove-properties": "0.3.1",
    "concurrently": "10.0.6",
    "cypress": "9.5.4",
    "cypress-file-upload": "5.0.8",
    "eslint-plugin-storybook": "10.6.3",
    "express": "4.22.3",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "lint-staged": "17.0.8",
    "mini-css-extract-plugin": "2.10.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.73.0",
    "pino-pretty": "13.1.3",
    "react-test-renderer": "19.3.1",
    "storybook": "10.6.3",
    "typescript": "6.0.2"
  }
}
