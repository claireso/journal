{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "none",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "sortPackageJson": false,
  "ignorePatterns": [
    ".next",
    "node_modules",
    "public",
    "coverage",
    "next-env.d.ts",
    "package-lock.json",
    ".claude",
    "**/*.md"
  ]
}
